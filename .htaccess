Options -MultiViews
RewriteEngine On
RewriteBase /royal-splash/

# Protect sensitive files
<FilesMatch "^(\.env|composer\.json|composer\.lock)$">
    Require all denied
</FilesMatch>

# Block direct browser access to private folders
RewriteRule ^(app|config|storage|vendor)(/.*)?$ - [F,L]

# Allow real files and folders like assets, uploads, images, CSS, JS
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route everything else to index.php
RewriteRule ^ index.php [QSA,L]